NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wealthflow
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: email delivery for reminders / monthly summaries.
# If left unset, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WealthFlow <no-reply@wealthflow.app>

# Set to "true" to disable the in-process cron scheduler (e.g. in tests)
DISABLE_SCHEDULER=false
